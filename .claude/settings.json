{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/device_lock.py\" hook",
            "timeout": 20,
            "statusMessage": "Checking the T-Deck lock"
          }
        ]
      }
    ]
  }
}
